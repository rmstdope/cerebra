FROM node:22-bookworm-slim
ARG CLAUDE_VERSION
ARG COPILOT_VERSION
RUN test -n "$CLAUDE_VERSION" && test -n "$COPILOT_VERSION" \
    && apt-get update \
    && apt-get install -y --no-install-recommends git gh ca-certificates python3 make g++ \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g "@anthropic-ai/claude-code@$CLAUDE_VERSION" "@github/copilot@$COPILOT_VERSION" \
    && useradd --create-home --shell /bin/bash agent
COPY sandbox/ /opt/cerebra/sandbox/
RUN chmod +x /opt/cerebra/sandbox/cerebra.mjs \
    && ln -s /opt/cerebra/sandbox/cerebra.mjs /usr/local/bin/cerebra
ENV HOME=/home/agent
USER agent
