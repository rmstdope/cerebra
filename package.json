{
  "name": "cerebra",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26.9.0 <27",
    "pnpm": ">=11.24.0 <12"
  },
  "scripts": {
    "build": "pnpm run typecheck && pnpm --filter @cerebra/ui build",
    "check": "pnpm run lint && pnpm run format:check && pnpm run test",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "globals": "17.4.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
