# Cerebro writes these while the fleet runs; the declarations beside them are tracked.
.cerebro/worktrees
.cerebro/state
.cerebro/scratch
.cerebro/scratchpad

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

node_modules/
packages/*/dist/
packages/*/dist-types/
packages/*/*.tsbuildinfo
.env
.env.*

# ./cerebra writes scheduled database backups here unless CEREBRA_BACKUP_DIR says otherwise.
/backups/
